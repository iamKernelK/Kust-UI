function KustUI:CreateDropdown(ParentFrame, Options)
    local theme = GetTheme()
    local Name = Options.Name or "Dropdown"
    local Items = Options.Items or {}
    local Default = Options.Default or Items[1]
    local Callback = Options.Callback or function() end
    
    local isExpanded = false
    local baseHeight = 42
    local itemHeight = 32
    
    local DropContainer = Instance.new("Frame", ParentFrame)
    DropContainer.Size = UDim2.new(1, 0, 0, baseHeight)
    DropContainer.BackgroundColor3 = theme.Surface
    DropContainer.ClipsDescendants = true
    Instance.new("UICorner", DropContainer).CornerRadius = UDim.new(0, 8)
    
    local Stroke = Instance.new("UIStroke", DropContainer)
    Stroke.Color = theme.Primary
    Stroke.Thickness = 1
    Stroke.Transparency = 0.8
    
    local DropBtn = Instance.new("TextButton", DropContainer)
    DropBtn.Size = UDim2.new(1, 0, 0, baseHeight)
    DropBtn.BackgroundTransparency = 1
    DropBtn.Text = ""
    
    local Title = Instance.new("TextLabel", DropBtn)
    Title.Size = UDim2.new(0.5, 0, 1, 0)
    Title.Position = UDim2.new(0, 12, 0, 0)
    Title.BackgroundTransparency = 1
    Title.Text = Name
    Title.TextColor3 = theme.Text
    Title.Font = Enum.Font.GothamSemibold
    Title.TextSize = 13
    Title.TextXAlignment = Enum.TextXAlignment.Left
    
    local SelectedText = Instance.new("TextLabel", DropBtn)
    SelectedText.Size = UDim2.new(0.4, 0, 1, 0)
    SelectedText.Position = UDim2.new(1, -35, 0, 0)
    SelectedText.AnchorPoint = Vector2.new(1, 0)
    SelectedText.BackgroundTransparency = 1
    SelectedText.Text = Default or "Select..."
    SelectedText.TextColor3 = theme.Primary
    SelectedText.Font = Enum.Font.GothamMedium
    SelectedText.TextSize = 12
    SelectedText.TextXAlignment = Enum.TextXAlignment.Right
    
    local Arrow = Instance.new("ImageLabel", DropBtn)
    Arrow.Size = UDim2.new(0, 16, 0, 16)
    Arrow.Position = UDim2.new(1, -12, 0.5, 0)
    Arrow.AnchorPoint = Vector2.new(1, 0.5)
    Arrow.BackgroundTransparency = 1
    Arrow.Image = "rbxassetid://10392248278"
    Arrow.ImageColor3 = theme.TextDim
    Arrow.Rotation = 90
    
    local ItemsScroll = Instance.new("ScrollingFrame", DropContainer)
    ItemsScroll.Size = UDim2.new(1, -16, 1, -baseHeight - 8)
    ItemsScroll.Position = UDim2.new(0, 8, 0, baseHeight)
    ItemsScroll.BackgroundTransparency = 1
    ItemsScroll.ScrollBarThickness = 2
    ItemsScroll.ScrollBarImageColor3 = theme.Primary
    
    local ItemsLayout = Instance.new("UIListLayout", ItemsScroll)
    ItemsLayout.Padding = UDim.new(0, 4)
    
    local function ToggleDrop()
        isExpanded = not isExpanded
        TweenService:Create(Arrow, TweenInfo.new(0.3), {Rotation = isExpanded and -90 or 90}):Play()
        
        local targetSize = isExpanded and (baseHeight + math.min(#Items * (itemHeight + 4), 120) + 12) or baseHeight
        TweenService:Create(DropContainer, TweenInfo.new(0.3, Enum.EasingStyle.Quart, Enum.EasingDirection.Out), {Size = UDim2.new(1, 0, 0, targetSize)}):Play()
    end
    
    DropBtn.MouseButton1Click:Connect(ToggleDrop)
    
    for _, item in ipairs(Items) do
        local ItemBtn = Instance.new("TextButton", ItemsScroll)
        ItemBtn.Size = UDim2.new(1, 0, 0, itemHeight)
        ItemBtn.BackgroundColor3 = theme.Background
        ItemBtn.Text = item
        ItemBtn.TextColor3 = theme.TextDim
        ItemBtn.Font = Enum.Font.GothamMedium
        ItemBtn.TextSize = 12
        Instance.new("UICorner", ItemBtn).CornerRadius = UDim.new(0, 6)
        
        ItemBtn.MouseButton1Click:Connect(function()
            SelectedText.Text = item
            Callback(item)
            ToggleDrop()
        end)
    end
    
    ItemsLayout:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(function()
        ItemsScroll.CanvasSize = UDim2.new(0, 0, 0, ItemsLayout.AbsoluteContentSize.Y)
    end)
    
    return DropContainer
end

