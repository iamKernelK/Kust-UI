-- 🎨 ELEMENT 5: TRUE RGB COLOR PICKER (UPDATED)
-- ==========================================================
function KustUI:CreateColorPicker(ParentFrame, Options)
    local theme = GetTheme()
    local Name = Options.Name or "Color Picker"
    local Default = Options.Default or Color3.fromRGB(255, 140, 0)
    local Callback = Options.Callback or function() end

    local isExpanded = false
    local baseHeight = 42
    
    local PickerFrame = Instance.new("Frame", ParentFrame)
    PickerFrame.Size = UDim2.new(1, 0, 0, baseHeight)
    PickerFrame.BackgroundColor3 = theme.Surface
    PickerFrame.ClipsDescendants = true
    Instance.new("UICorner", PickerFrame).CornerRadius = UDim.new(0, 8)

    local Stroke = Instance.new("UIStroke", PickerFrame)
    Stroke.Color = theme.Primary
    Stroke.Thickness = 1
    Stroke.Transparency = 0.8

    local HeaderBtn = Instance.new("TextButton", PickerFrame)
    HeaderBtn.Size = UDim2.new(1, 0, 0, baseHeight)
    HeaderBtn.BackgroundTransparency = 1
    HeaderBtn.Text = ""

    local Title = Instance.new("TextLabel", HeaderBtn)
    Title.Size = UDim2.new(1, -60, 1, 0)
    Title.Position = UDim2.new(0, 12, 0, 0)
    Title.BackgroundTransparency = 1
    Title.Text = Name
    Title.TextColor3 = theme.Text
    Title.Font = Enum.Font.GothamSemibold
    Title.TextSize = 13
    Title.TextXAlignment = Enum.TextXAlignment.Left

    local ColorPreview = Instance.new("Frame", HeaderBtn)
    ColorPreview.Size = UDim2.new(0, 32, 0, 22)
    ColorPreview.Position = UDim2.new(1, -12, 0.5, 0)
    ColorPreview.AnchorPoint = Vector2.new(1, 0.5)
    ColorPreview.BackgroundColor3 = Default
    Instance.new("UICorner", ColorPreview).CornerRadius = UDim.new(0, 6)
    
    -- RGB Sliders Container
    local SlidersContainer = Instance.new("Frame", PickerFrame)
    SlidersContainer.Size = UDim2.new(1, -24, 0, 90)
    SlidersContainer.Position = UDim2.new(0, 12, 0, baseHeight)
    SlidersContainer.BackgroundTransparency = 1
    
    local function CreateRGBSlider(colorName, yPos, colorVal, defaultVal)
        local Label = Instance.new("TextLabel", SlidersContainer)
        Label.Size = UDim2.new(0, 15, 0, 20)
        Label.Position = UDim2.new(0, 0, 0, yPos)
        Label.BackgroundTransparency = 1
        Label.Text = colorName
        Label.TextColor3 = colorVal
        Label.Font = Enum.Font.GothamBold
        
        local Track = Instance.new("Frame", SlidersContainer)
        Track.Size = UDim2.new(1, -25, 0, 6)
        Track.Position = UDim2.new(0, 25, 0, yPos + 7)
        Track.BackgroundColor3 = theme.Background
        Instance.new("UICorner", Track).CornerRadius = UDim.new(1, 0)
        
        local Fill = Instance.new("Frame", Track)
        Fill.Size = UDim2.new(defaultVal/255, 0, 1, 0)
        Fill.BackgroundColor3 = colorVal
        Instance.new("UICorner", Fill).CornerRadius = UDim.new(1, 0)
        
        local Btn = Instance.new("TextButton", Track)
        Btn.Size = UDim2.new(1, 0, 1, 10)
        Btn.Position = UDim2.new(0, 0, 0.5, -5)
        Btn.BackgroundTransparency = 1
        Btn.Text = ""
        
        return Btn, Fill, Track
    end
    
    local rBtn, rFill, rTrack = CreateRGBSlider("R", 0, Color3.fromRGB(255, 80, 80), math.floor(Default.R*255))
    local gBtn, gFill, gTrack = CreateRGBSlider("G", 30, Color3.fromRGB(80, 255, 80), math.floor(Default.G*255))
    local bBtn, bFill, bTrack = CreateRGBSlider("B", 60, Color3.fromRGB(80, 180, 255), math.floor(Default.B*255))
    
    local currentR, currentG, currentB = Default.R, Default.G, Default.B
    
    local function UpdateColor()
        local newColor = Color3.new(currentR, currentG, currentB)
        ColorPreview.BackgroundColor3 = newColor
        Callback(newColor)
    end
    
    local function HandleSlider(btn, fill, track, colorType)
        local dragging = false
        btn.InputBegan:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1 then dragging = true end
        end)
        UserInputService.InputEnded:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1 then dragging = false end
        end)
        UserInputService.InputChanged:Connect(function(input)
            if dragging and input.UserInputType == Enum.UserInputType.MouseMovement then
                local pos = math.clamp((input.Position.X - track.AbsolutePosition.X) / track.AbsoluteSize.X, 0, 1)
                fill.Size = UDim2.new(pos, 0, 1, 0)
                if colorType == "R" then currentR = pos
                elseif colorType == "G" then currentG = pos
                elseif colorType == "B" then currentB = pos end
                UpdateColor()
            end
        end)
    end
    
    HandleSlider(rBtn, rFill, rTrack, "R")
    HandleSlider(gBtn, gFill, gTrack, "G")
    HandleSlider(bBtn, bFill, bTrack, "B")

    HeaderBtn.MouseButton1Click:Connect(function()
        isExpanded = not isExpanded
        TweenService:Create(PickerFrame, TweenInfo.new(0.3, Enum.EasingStyle.Quart, Enum.EasingDirection.Out), {
            Size = UDim2.new(1, 0, 0, isExpanded and (baseHeight + 100) or baseHeight)
        }):Play()
    end)

    return PickerFrame
end

return KustUI
