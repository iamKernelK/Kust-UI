function KustUI:CreateTab(Options)
    local theme = GetTheme()
    local Name = Options.Name or "Tab"
    local IconId = Options.Icon

    local existingTabs = 0
    for _, v in ipairs(self.ElementsMenu:GetChildren()) do
        if v.Name:match("_Container") then existingTabs = existingTabs + 1 end
    end
    local isFirstTab = (existingTabs == 0)

    local TabButton = Instance.new("TextButton", self.TabsMenu)
    TabButton.Size = UDim2.new(1, 0, 0, 38)
    TabButton.BackgroundColor3 = isFirstTab and theme.Surface or theme.Background
    TabButton.Text = ""
    TabButton.AutoButtonColor = false
    Instance.new("UICorner", TabButton).CornerRadius = UDim.new(0, 8)

    local Stroke = Instance.new("UIStroke", TabButton)
    Stroke.Color = theme.Primary
    Stroke.Thickness = 1
    Stroke.Transparency = isFirstTab and 0.2 or 1

    local TextOffset = 12
    if IconId then
        local Icon = Instance.new("ImageLabel", TabButton)
        Icon.Size = UDim2.new(0, 18, 0, 18)
        Icon.Position = UDim2.new(0, 12, 0.5, 0)
        Icon.AnchorPoint = Vector2.new(0, 0.5)
        Icon.BackgroundTransparency = 1
        Icon.Image = IconId
        Icon.ImageColor3 = isFirstTab and theme.Primary or theme.TextDim
        TextOffset = 38
    end

    local Title = Instance.new("TextLabel", TabButton)
    Title.Size = UDim2.new(1, -TextOffset - 8, 1, 0)
    Title.Position = UDim2.new(0, TextOffset, 0, 0)
    Title.BackgroundTransparency = 1
    Title.Text = Name
    Title.TextColor3 = isFirstTab and theme.Text or theme.TextDim
    Title.Font = Enum.Font.GothamSemibold
    Title.TextSize = 13
    Title.TextXAlignment = Enum.TextXAlignment.Left

    local TabContainer = Instance.new("ScrollingFrame", self.ElementsMenu)
    TabContainer.Name = Name .. "_Container"
    TabContainer.Size = UDim2.new(1, 0, 1, 0)
    TabContainer.BackgroundTransparency = 1
    TabContainer.ScrollBarThickness = 3
    TabContainer.ScrollBarImageColor3 = theme.Primary
    TabContainer.Visible = isFirstTab
    TabContainer.AutomaticCanvasSize = Enum.AutomaticSize.Y

    local Padding = Instance.new("UIPadding", TabContainer)
    Padding.PaddingTop = UDim.new(0, 12)
    Padding.PaddingBottom = UDim.new(0, 18)
    Padding.PaddingLeft = UDim.new(0, 14)
    Padding.PaddingRight = UDim.new(0, 14)

    local Layout = Instance.new("UIListLayout", TabContainer)
    Layout.SortOrder = Enum.SortOrder.LayoutOrder
    Layout.Padding = UDim.new(0, 8)

    TabButton.MouseButton1Click:Connect(function()
        if TabContainer.Visible then return end
        for _, child in ipairs(self.ElementsMenu:GetChildren()) do
            if child:IsA("ScrollingFrame") then child.Visible = false end
        end
        for _, btn in ipairs(self.TabsMenu:GetChildren()) do
            if btn:IsA("TextButton") then
                TweenService:Create(btn, TweenInfo.new(0.2), {BackgroundColor3 = theme.Background}):Play()
                btn:FindFirstChild("UIStroke").Transparency = 1
                btn:FindFirstChildOfClass("TextLabel").TextColor3 = theme.TextDim
                local icon = btn:FindFirstChildOfClass("ImageLabel")
                if icon then icon.ImageColor3 = theme.TextDim end
            end
        end
        TabContainer.Visible = true
        TweenService:Create(TabButton, TweenInfo.new(0.25), {BackgroundColor3 = theme.Surface}):Play()
        TweenService:Create(Stroke, TweenInfo.new(0.25), {Transparency = 0.2}):Play()
        TweenService:Create(Title, TweenInfo.new(0.25), {TextColor3 = theme.Text}):Play()
        local currentIcon = TabButton:FindFirstChildOfClass("ImageLabel")
        if currentIcon then TweenService:Create(currentIcon, TweenInfo.new(0.25), {ImageColor3 = theme.Primary}):Play() end
    end)

    return TabContainer
end

